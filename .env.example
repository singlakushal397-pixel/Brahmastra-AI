# Server-side OpenAI configuration (NEVER expose OPENAI_API_KEY to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Server settings
HOST=127.0.0.1
PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500

# Security & Rate Limiting
MAX_REQUESTS_PER_MINUTE=20
MAX_MESSAGE_LENGTH=2000
ENABLE_ENCRYPTED_SESSION_PERSISTENCE=false
SESSION_ENCRYPTION_KEY=
